AI_PDF_PAGES_PER_CHUNK=3
AI_PDF_RENDER_SCALE=1.5
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_RENDER_DPI=220
TESSERACT_CMD=
WORKER_UPLOAD_MAX_JOBS=5