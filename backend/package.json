{
  "engines": {
    "node": "22.x"
  },
  "name": "paperflow-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:check": "node src/db/check.js",
